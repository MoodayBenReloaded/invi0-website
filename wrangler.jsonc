{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invi0-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
